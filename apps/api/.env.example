NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Development database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saleem_platform

# Integration tests use a separate database.
# Set TEST_DATABASE_URL in the test environment.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saleem_platform_test

# Comma-separated origins. Do not use * in production.
# CORS_ORIGINS=http://localhost:4200,http://localhost:4201,https://saleemkhan.dev

# Optional logging level.
# LOG_LEVEL=info